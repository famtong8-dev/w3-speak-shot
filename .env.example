# Copy this file to .env and adjust values as needed.
# .env is loaded automatically at startup if present.

# Base TTS playback speed (0.75 – 2.0, default: 1.5)
W3_TTS_SPEED_FACTOR=1.5

# Debug: save TTS audio output to a WAV file instead of playing
# W3_DEBUG_TTS_OUTPUT=/tmp/w3_debug.wav

# Keep temp WAV files after playback (true/false, default: false)
# W3_KEEP_TEMP_AUDIO=false

# Directory for temp WAV files (default: system temp dir)
# W3_TEMP_AUDIO_DIR=/tmp
